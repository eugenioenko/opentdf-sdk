package io.opentdf.tdf3;

import io.goalchemy.runtime.Callback;
import io.goalchemy.runtime.Library;
import java.nio.charset.*;
import java.nio.*;
import java.util.concurrent.*;
import java.util.function.Function;

/** The handle API's host token provider: a TokenProvider resolves a ProviderRequest with an AccessToken. */
public final class TDF3 {
 private TDF3() {}
 public record AccessToken(String value,String scheme,long expiresAt,String confirmationJKT) {}
 public static final class ProviderRequest {
  private final Callback.Request request;
  ProviderRequest(Callback.Request request){this.request=request;}
  public boolean canceled(){return request.canceled();}
  public void retain(){request.retain();}
  public void onStop(Runnable stop){request.onStop(stop);}
  public void resolve(AccessToken token){try{request.resolve(tokenBytes(token));}catch(IllegalArgumentException|Library.Failure e){request.reject("provider: invalid token response");}}
  public void reject(String message){request.reject(message);}
  public void fault(Throwable fault){request.fault(fault);}
 }
 @FunctionalInterface public interface TokenProvider { void start(ProviderRequest request)throws Exception; }
 public static TokenProvider fromStage(Function<ProviderRequest,? extends CompletionStage<AccessToken>> provider){
  return request->{CompletionStage<AccessToken> stage=provider.apply(request);if(stage==null)throw new IllegalStateException("null token stage");request.retain();stage.whenComplete((token,error)->{if(error!=null)request.reject("provider: rejected");else request.resolve(token);});};
 }
 private static String encode(String value){if(value==null)return "";try{ByteBuffer encoded=StandardCharsets.UTF_8.newEncoder().onMalformedInput(CodingErrorAction.REPORT).onUnmappableCharacter(CodingErrorAction.REPORT).encode(CharBuffer.wrap(value));byte[] a=new byte[encoded.remaining()];encoded.get(a);return new String(a,StandardCharsets.ISO_8859_1);}catch(CharacterCodingException e){throw Library.invalid();}}
 private static String quote(String s){if(s==null)s="";StringBuilder b=new StringBuilder("\"");for(int i=0;i<s.length();i++){char c=s.charAt(i);if(c=='"'||c=='\\')b.append('\\').append(c);else if(c<32)b.append(String.format(java.util.Locale.ROOT,"\\u%04x",(int)c));else b.append(c);}return b.append('"').toString();}
 private static byte[] tokenBytes(AccessToken t){if(t==null||t.value==null||t.scheme==null||t.expiresAt<0||t.value.length()>65536||t.scheme.length()>128||t.confirmationJKT!=null&&t.confirmationJKT.length()>256)throw new IllegalArgumentException("invalid token");String json="{\"value\":"+quote(t.value)+",\"scheme\":"+quote(t.scheme)+",\"expiresAt\":"+quote(Long.toString(t.expiresAt))+",\"confirmationJKT\":"+quote(t.confirmationJKT)+"}";return encode(json).getBytes(StandardCharsets.ISO_8859_1);}
}
