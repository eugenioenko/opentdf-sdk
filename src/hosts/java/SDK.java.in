package io.opentdf.tdf3;

import com.google.protobuf.InvalidProtocolBufferException;
import com.google.protobuf.Message;
import com.google.protobuf.util.JsonFormat;
import io.opentdf.tdf3.protocol.authorization.Entity;
import io.opentdf.tdf3.protocol.policy.Attribute;
import io.goalchemy.generated.Generated;
import io.goalchemy.runtime.Callback;
import io.goalchemy.runtime.Library;
import java.time.Duration;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CompletableFuture;

/**
 * The reference SDK handle (api-spec.md) in Java idiom: a builder over the
 * shared-source Options, blocking methods with an optional Duration, and
 * *Async twins returning a CompletableFuture whose cancel cancels the call.
 * The platform service clients (attributes(), namespaces(), ...) take and
 * return the protobuf-java messages of io.opentdf.tdf3.protocol, which cross
 * to the generated package as protobuf JSON. The adapter maps names, idioms
 * and errors only; the protocol executes in the generated package.
 */
public final class SDK extends PlatformServices implements AutoCloseable {
 /** A KAS public key for storeKASKeys (reference KasPublicKey). */
 public record KasPublicKey(String pem, String kid, String alg) {}
 /** The reference's ConnectRPCConnection: the endpoint a connection reaches. */
 public record ConnectRPCConnection(String endpoint) {}

 /** The reference's AuthClient: authentication operations of an SDK. */
 public static final class AuthClient {
  private final SDK sdk;
  private AuthClient(SDK sdk) { this.sdk = sdk; }
  /** A valid access token for the SDK's credentials; fails with the reference's ErrNoAccessTokenSource without credentials. */
  public TDF3.AccessToken accessToken() { return accessToken(null); }
  public TDF3.AccessToken accessToken(Duration timeout) {
   Generated.AuthClient client = Values.await(Values.run(() -> sdk.handle.Auth(sdk.call())), timeout);
   try {
    return token(Values.await(Values.run(() -> client.AccessToken(sdk.call())), timeout));
   } finally {
    Values.await(client.closeAsync(), null);
   }
  }
  public CompletableFuture<TDF3.AccessToken> accessTokenAsync() {
   return Values.future(Values.run(() -> sdk.handle.Auth(sdk.call())), c -> c).thenCompose(client ->
    Values.future(Values.run(() -> client.AccessToken(sdk.call())), AuthClient::token)
     .whenComplete((t, e) -> client.closeAsync()));
  }
  private static TDF3.AccessToken token(Generated.AccessToken t) {
   return new TDF3.AccessToken(Values.decode(t.Value), Values.decode(t.Scheme), t.ExpiresAt, Values.decode(t.ConfirmationJKT));
  }
 }

 static final String TOKEN_PROVIDER = "access-token";
 private final Generated.SDK handle;
 private final Callback.Registration[] callbacks;
 private final JsonFormat.Printer printer;
 private final JsonFormat.Parser parser;

 private SDK(Generated.SDK handle, Callback.Registration[] callbacks) {
  this.handle = handle;
  this.callbacks = callbacks;
  JsonFormat.TypeRegistry types = JsonFormat.TypeRegistry.newBuilder().add(descriptors()).build();
  printer = JsonFormat.printer().usingTypeRegistry(types).omittingInsignificantWhitespace();
  parser = JsonFormat.parser().usingTypeRegistry(types).ignoringUnknownFields();
 }

 Library.Options call() {
  Library.Options o = new Library.Options();
  o.callbacks = callbacks;
  return o;
 }

 /** The reference's New: options over the platform endpoint, then build(). */
 public static Builder builder(String platformEndpoint) { return new Builder(platformEndpoint); }

 public static final class Builder {
  private final String endpoint;
  private final Generated.Options o = new Generated.Options();
  private TDF3.TokenProvider provider;
  private Builder(String endpoint) {
   if (endpoint == null) throw Library.invalid();
   this.endpoint = endpoint;
  }
  /** WithClientCredentials */
  public Builder clientCredentials(String clientId, String clientSecret) { o.ClientID = Values.encode(clientId); o.ClientSecret = Values.encode(clientSecret); return this; }
  public Builder scopes(List<String> scopes) { o.Scopes = Values.encode(scopes); return this; }
  /** WithTokenEndpoint */
  public Builder tokenEndpoint(String endpoint) { o.TokenEndpoint = Values.encode(endpoint); return this; }
  /** WithTokenExchange; unsupported in this build. */
  public Builder tokenExchange(String subjectToken, List<String> audience) { o.TokenExchange = new Generated.TokenExchange(); o.TokenExchange.SubjectToken = Values.encode(subjectToken); o.TokenExchange.Audience = Values.encode(audience); return this; }
  /** WithCertExchange; unsupported in this build. */
  public Builder certExchange(String clientCertPem, String clientKeyPem, List<String> audience) { o.CertExchange = new Generated.CertExchange(); o.CertExchange.ClientCertPEM = Values.encode(clientCertPem); o.CertExchange.ClientKeyPEM = Values.encode(clientKeyPem); o.CertExchange.Audience = Values.encode(audience); return this; }
  /** A host token source (WithOAuthAccessTokenSource); replaces client credentials. */
  public Builder tokenProvider(TDF3.TokenProvider provider) { this.provider = provider; o.TokenProviderName = provider == null ? "" : TOKEN_PROVIDER; return this; }
  /** WithPlatformConfiguration; non-string members are carried as JSON text. */
  public Builder platformConfiguration(Map<String, ?> configuration) {
   List<Generated.PlatformConfigurationEntry> entries = new ArrayList<>();
   for (Map.Entry<String, ?> e : configuration.entrySet()) {
    Generated.PlatformConfigurationEntry entry = new Generated.PlatformConfigurationEntry();
    entry.Key = Values.encode(e.getKey());
    entry.Value = Values.encode(e.getValue() instanceof String s ? s : Values.json(e.getValue()));
    entries.add(entry);
   }
   o.PlatformConfiguration = new Generated.PlatformConfiguration();
   o.PlatformConfiguration.Entries = entries.toArray(new Generated.PlatformConfigurationEntry[0]);
   return this;
  }
  /** WithConnectionValidation */
  public Builder validateConnection(boolean validate) { o.ValidateConnection = validate; return this; }
  /** WithInsecurePlaintextConn */
  public Builder insecurePlaintext(boolean allow) { o.InsecurePlaintext = allow; return this; }
  /** WithInsecureSkipVerifyConn */
  public Builder insecureSkipVerify(boolean skip) { o.InsecureSkipVerify = skip; return this; }
  /** WithTLSCredentials; unsupported in this build. */
  public Builder tls(String clientCertPem, String clientKeyPem, String rootCasPem, List<String> audience) { o.TLS = new Generated.TLSOptions(); o.TLS.ClientCertPEM = Values.encode(clientCertPem); o.TLS.ClientKeyPEM = Values.encode(clientKeyPem); o.TLS.RootCAsPEM = Values.encode(rootCasPem); o.TLS.Audience = Values.encode(audience); return this; }
  /** WithIPC equivalent; unsupported in this build. */
  public Builder unixSocket(String path) { o.UnixSocket = Values.encode(path); return this; }
  /** Per-request timeout; null or zero keeps the reference default. */
  public Builder timeout(Duration timeout) { o.TimeoutMillis = timeout == null ? 0 : timeout.toMillis(); return this; }
  public Builder coreEndpoint(String endpoint) { o.CoreEndpoint = Values.encode(endpoint); return this; }
  public Builder policyEndpoint(String endpoint) { o.PolicyEndpoint = Values.encode(endpoint); return this; }
  public Builder authorizationEndpoint(String endpoint) { o.AuthorizationEndpoint = Values.encode(endpoint); return this; }
  public Builder entityResolutionEndpoint(String endpoint) { o.EntityResolutionEndpoint = Values.encode(endpoint); return this; }
  public Builder wellknownEndpoint(String endpoint) { o.WellknownEndpoint = Values.encode(endpoint); return this; }
  /** WithSessionEncryptionRSA */
  public Builder sessionEncryptionRsaPem(String pem) { o.SessionEncryptionRSAPEM = Values.encode(pem); return this; }
  /** WithSessionSignerRSA; unsupported in this build. */
  public Builder sessionSignerRsaPem(String pem) { o.SessionSignerRSAPEM = Values.encode(pem); return this; }
  /** WithDPoPAlgorithm: ES256, ES384, ES512, RS256, RS384 or RS512. */
  public Builder dpopAlgorithm(String algorithm) { o.DPoPAlgorithm = Values.encode(algorithm); return this; }
  /** WithDPoPKeyPEM */
  public Builder dpopKeyPem(String pem) { o.DPoPKeyPEM = Values.encode(pem); return this; }
  /** WithNoKIDInKAO */
  public Builder noKidInKao(boolean noKid) { o.NoKIDInKAO = noKid; return this; }
  /** WithFulfillableObligationFQNs */
  public Builder fulfillableObligationFqns(List<String> fqns) { o.FulfillableObligationFQNs = Values.encode(fqns); return this; }
  /** WithLogger level: a slog level (-4 debug, 0 info, 4 warn, 8 error); 0 keeps the host sink default. */
  public Builder logLevel(long level) { o.LogLevel = level; return this; }

  private Callback.Registration[] callbacks() {
   return provider == null ? null : new Callback.Registration[]{new Callback.Registration(TOKEN_PROVIDER, request -> provider.start(new TDF3.ProviderRequest(request)))};
  }
  private Library.Operation<Generated.SDK> start(Callback.Registration[] callbacks) {
   Library.Options call = new Library.Options();
   call.callbacks = callbacks;
   return Values.run(() -> Generated.New(Values.encode(endpoint), o, call));
  }
  /** Discovers the platform configuration and the token endpoint. */
  public SDK build() { return build(null); }
  public SDK build(Duration timeout) {
   Callback.Registration[] callbacks = callbacks();
   return new SDK(Values.await(start(callbacks), timeout), callbacks);
  }
  public CompletableFuture<SDK> buildAsync() {
   Callback.Registration[] callbacks = callbacks();
   return Values.future(start(callbacks), h -> new SDK(h, callbacks));
  }
 }

 /** The reference's CreateTDF over bytes: the TDF bytes with their TDFObject handle. */
 public TDFObject createTDF(byte[] plaintext, TDFOptions options) { return createTDF(plaintext, options, null); }
 public TDFObject createTDF(byte[] plaintext, TDFOptions options, Duration timeout) { return object(Values.await(startCreate(plaintext, options), timeout)); }
 public CompletableFuture<TDFObject> createTDFAsync(byte[] plaintext, TDFOptions options) { return Values.future(startCreate(plaintext, options), this::object); }
 private Library.Operation<Generated.SDK.SDKEncryptBytesResult> startCreate(byte[] plaintext, TDFOptions options) {
  return Values.run(() -> handle.EncryptBytes(Values.bytes(plaintext), (options == null ? TDFOptions.builder().build() : options).toGenerated(), call()));
 }
 private TDFObject object(Generated.SDK.SDKEncryptBytesResult r) { return new TDFObject(r.value0(), r.value1(), this); }

 /** createTDF without keeping the handle: the TDF bytes only. */
 public byte[] encryptBytes(byte[] plaintext, TDFOptions options) { return encryptBytes(plaintext, options, null); }
 public byte[] encryptBytes(byte[] plaintext, TDFOptions options, Duration timeout) {
  TDFObject object = createTDF(plaintext, options, timeout);
  object.close();
  return object.bytes();
 }
 public CompletableFuture<byte[]> encryptBytesAsync(byte[] plaintext, TDFOptions options) {
  return createTDFAsync(plaintext, options).thenCompose(o -> o.closeAsync().thenApply(v -> o.bytes()));
 }

 /** The reference's LoadTDF over bytes. */
 public Reader loadTDF(byte[] ciphertext, ReaderOptions options) { return loadTDF(ciphertext, options, null); }
 public Reader loadTDF(byte[] ciphertext, ReaderOptions options, Duration timeout) { return new Reader(Values.await(startLoad(ciphertext, options), timeout), this); }
 public CompletableFuture<Reader> loadTDFAsync(byte[] ciphertext, ReaderOptions options) { return Values.future(startLoad(ciphertext, options), r -> new Reader(r, this)); }
 private Library.Operation<Generated.Reader> startLoad(byte[] ciphertext, ReaderOptions options) {
  return Values.run(() -> handle.LoadTDF(Values.bytes(ciphertext), (options == null ? ReaderOptions.defaults() : options).toGenerated(), call()));
 }

 /** The reference's DecryptBytes. */
 public byte[] decryptBytes(byte[] ciphertext, ReaderOptions options) { return decryptBytes(ciphertext, options, null); }
 public byte[] decryptBytes(byte[] ciphertext, ReaderOptions options, Duration timeout) { return orEmpty(Values.await(startDecrypt(ciphertext, options), timeout)); }
 public CompletableFuture<byte[]> decryptBytesAsync(byte[] ciphertext, ReaderOptions options) { return Values.future(startDecrypt(ciphertext, options), SDK::orEmpty); }
 private Library.Operation<byte[]> startDecrypt(byte[] ciphertext, ReaderOptions options) {
  return Values.run(() -> handle.DecryptBytes(Values.bytes(ciphertext), (options == null ? ReaderOptions.defaults() : options).toGenerated(), call()));
 }
 private static byte[] orEmpty(byte[] b) { return b == null ? new byte[0] : b; }

 public boolean isHealthy() { return isHealthy(null); }
 public boolean isHealthy(Duration timeout) { return Values.await(Values.run(() -> handle.IsHealthy(call())), timeout); }
 public CompletableFuture<Boolean> isHealthyAsync() { return Values.future(Values.run(() -> handle.IsHealthy(call())), b -> b); }

 /** The platform configuration members as strings (non-string members as compact JSON). */
 public Map<String, String> platformConfiguration() { return configuration(Values.await(Values.run(() -> handle.PlatformConfiguration(call())), null)); }
 public CompletableFuture<Map<String, String>> platformConfigurationAsync() { return Values.future(Values.run(() -> handle.PlatformConfiguration(call())), SDK::configuration); }
 private static Map<String, String> configuration(Generated.PlatformConfiguration c) {
  Map<String, String> out = new LinkedHashMap<>();
  if (c != null && c.Entries != null) for (Generated.PlatformConfigurationEntry e : c.Entries) out.put(Values.decode(e.Key), Values.decode(e.Value));
  return java.util.Collections.unmodifiableMap(out);
 }

 /** The reference's GetBaseKey, keyed by the reference's JSON tags (kasUri, publicKey{algorithm,kid,pem}, kasId). */
 public Map<String, Object> getBaseKey() { return getBaseKey(null); }
 public Map<String, Object> getBaseKey(Duration timeout) { return Values.map(Values.await(Values.run(() -> handle.GetBaseKey(call())), timeout)); }
 public CompletableFuture<Map<String, Object>> getBaseKeyAsync() { return Values.future(Values.run(() -> handle.GetBaseKey(call())), Values::map); }

 /** The reference's StoreKASKeys. */
 public void storeKASKeys(String url, List<KasPublicKey> keys) { Values.await(startStore(url, keys), null); }
 public CompletableFuture<Void> storeKASKeysAsync(String url, List<KasPublicKey> keys) { return Values.future(startStore(url, keys), v -> null); }
 private Library.Operation<Void> startStore(String url, List<KasPublicKey> keys) {
  Generated.KasPublicKeySet set = new Generated.KasPublicKeySet();
  set.Keys = new Generated.KasPublicKey[keys.size()];
  for (int i = 0; i < keys.size(); i++) {
   Generated.KasPublicKey k = new Generated.KasPublicKey();
   k.Pem = Values.encode(keys.get(i).pem()); k.Kid = Values.encode(keys.get(i).kid()); k.Alg = Values.encode(keys.get(i).alg());
   set.Keys[i] = k;
  }
  return Values.run(() -> handle.StoreKASKeys(Values.encode(url), set, call()));
 }

 /**
  * Sends one unary request to a platform service method, such as
  * ("policy.attributes.AttributesService", "ListAttributes"), with the
  * request and reply in protobuf JSON: the shared source's SDK.Call.
  */
 public String call(String service, String method, String request) { return call(service, method, request, null); }
 public String call(String service, String method, String request, Duration timeout) { return Values.decode(Values.await(startCall(service, method, request), timeout)); }
 public CompletableFuture<String> callAsync(String service, String method, String request) { return Values.future(startCall(service, method, request), Values::decode); }
 private Library.Operation<String> startCall(String service, String method, String request) {
  return Values.run(() -> {
   if (service == null || method == null || request == null) throw Library.invalid();
   return handle.Call(Values.encode(service), Values.encode(method), Values.encode(request), call());
  });
 }

 @Override <T extends Message> T serviceCall(String service, String method, Message request, T prototype, Duration timeout) {
  return decode(call(service, method, encode(request), timeout), prototype);
 }
 @Override <T extends Message> CompletableFuture<T> serviceCallAsync(String service, String method, Message request, T prototype) {
  String body;
  try {
   body = encode(request);
  } catch (RuntimeException e) {
   return CompletableFuture.failedFuture(e);
  }
  return callAsync(service, method, body).thenApply(json -> decode(json, prototype));
 }
 private String encode(Message request) {
  if (request == null) throw new OpenTDFException(Library.invalid());
  try {
   return printer.print(request);
  } catch (InvalidProtocolBufferException e) {
   throw OpenTDFException.boundary("invalid_input", "marshal message: " + e.getMessage());
  }
 }
 @SuppressWarnings("unchecked") private <T extends Message> T decode(String json, T prototype) {
  Message.Builder builder = prototype.newBuilderForType();
  try {
   parser.merge(json, builder);
  } catch (InvalidProtocolBufferException e) {
   throw OpenTDFException.boundary("transport", "unmarshal message: " + e.getMessage());
  }
  return (T) builder.build();
 }

 /** The reference's Auth: the SDK's authentication operations. */
 public AuthClient auth() { return new AuthClient(this); }

 /** The reference's Conn: the endpoint of the core services. */
 public ConnectRPCConnection conn() { return conn(null); }
 public ConnectRPCConnection conn(Duration timeout) { return connection(Values.await(Values.run(() -> handle.Conn(call())), timeout)); }
 public CompletableFuture<ConnectRPCConnection> connAsync() { return Values.future(Values.run(() -> handle.Conn(call())), SDK::connection); }
 private static ConnectRPCConnection connection(Generated.ConnectRPCConnection c) { return new ConnectRPCConnection(Values.decode(c.Endpoint)); }

 /** The reference's ListAttributes: every active attribute, following the pages; namespace (name or id) null lists all. */
 public List<Attribute> listAttributes() { return listAttributes(null, null); }
 public List<Attribute> listAttributes(String namespace) { return listAttributes(namespace, null); }
 public List<Attribute> listAttributes(String namespace, Duration timeout) { return attributes(Values.await(startList(namespace), timeout)); }
 public CompletableFuture<List<Attribute>> listAttributesAsync(String namespace) { return Values.future(startList(namespace), this::attributes); }
 private Library.Operation<String[]> startList(String namespace) {
  return Values.run(() -> handle.ListAttributesJSON(namespace == null ? new String[0] : new String[]{Values.encode(namespace)}, call()));
 }
 private List<Attribute> attributes(String[] json) {
  List<Attribute> out = new ArrayList<>();
  if (json != null) for (String text : json) out.add(decode(Values.decode(text), Attribute.getDefaultInstance()));
  return java.util.Collections.unmodifiableList(out);
 }

 /** The reference's GetEntityAttributes: the attribute value FQNs entitled to an entity. */
 public List<String> getEntityAttributes(Entity entity) { return getEntityAttributes(entity, null); }
 public List<String> getEntityAttributes(Entity entity, Duration timeout) { return Values.decode(Values.await(startEntitlements(entity), timeout)); }
 public CompletableFuture<List<String>> getEntityAttributesAsync(Entity entity) {
  try {
   return Values.future(startEntitlements(entity), Values::decode);
  } catch (RuntimeException e) {
   return CompletableFuture.failedFuture(e);
  }
 }
 private Library.Operation<String[]> startEntitlements(Entity entity) {
  String request = entity == null ? "" : encode(entity);
  return Values.run(() -> handle.GetEntityAttributesJSON(Values.encode(request), call()));
 }

 /** The reference's ValidateAttributes: fails with ErrAttributeNotFound naming the missing value FQNs. */
 public void validateAttributes(List<String> fqns) { validateAttributes(fqns, null); }
 public void validateAttributes(List<String> fqns, Duration timeout) { Values.await(startValidate(fqns), timeout); }
 public CompletableFuture<Void> validateAttributesAsync(List<String> fqns) { return Values.future(startValidate(fqns), v -> null); }
 private Library.Operation<Void> startValidate(List<String> fqns) {
  return Values.run(() -> {
   if (fqns == null) throw Library.invalid();
   return handle.ValidateAttributes(Values.encode(fqns), call());
  });
 }

 /** The reference's AttributeExists for an attribute FQN (https://<namespace>/attr/<name>). */
 public boolean attributeExists(String fqn) { return attributeExists(fqn, null); }
 public boolean attributeExists(String fqn, Duration timeout) { return Values.await(Values.run(() -> handle.AttributeExists(Values.encode(fqn), call())), timeout); }
 public CompletableFuture<Boolean> attributeExistsAsync(String fqn) { return Values.future(Values.run(() -> handle.AttributeExists(Values.encode(fqn), call())), b -> b); }

 /** The reference's AttributeValueExists for a value FQN (.../attr/<name>/value/<value>). */
 public boolean attributeValueExists(String fqn) { return attributeValueExists(fqn, null); }
 public boolean attributeValueExists(String fqn, Duration timeout) { return Values.await(Values.run(() -> handle.AttributeValueExists(Values.encode(fqn), call())), timeout); }
 public CompletableFuture<Boolean> attributeValueExistsAsync(String fqn) { return Values.future(Values.run(() -> handle.AttributeValueExists(Values.encode(fqn), call())), b -> b); }

 /** Releases the handle; later calls fail with kind "closed". */
 @Override public void close() {
  try {
   handle.close();
  } catch (Library.Failure f) {
   throw new OpenTDFException(f);
  }
 }
 public CompletableFuture<Void> closeAsync() { return Values.future(handle.closeAsync(), v -> null); }

 // Free functions of the reference, each a library call.
 public static boolean isValidTdf(byte[] data) { return Values.await(Values.run(() -> Generated.IsValidTdf(Values.bytes(data), new Library.Options())), null); }
 public static String getTdfType(byte[] data) { return Values.decode(Values.await(Values.run(() -> Generated.GetTdfType(Values.bytes(data), new Library.Options())), null)); }
 public static boolean isPlatformEndpointMalformed(String endpoint) { return Values.await(Values.run(() -> Generated.IsPlatformEndpointMalformed(Values.encode(endpoint), new Library.Options())), null); }
 /** The reference's AttributeNameFQN and AttributeValueFQN: the FQN as given and its lower-case key. */
 public record AttributeFQN(String url, String key) {
  static AttributeFQN of(Generated.AttributeNameFQN f) { return new AttributeFQN(Values.decode(f.URL), Values.decode(f.Key)); }
  static AttributeFQN of(Generated.AttributeValueFQN f) { return new AttributeFQN(Values.decode(f.URL), Values.decode(f.Key)); }
 }
 public static AttributeFQN newAttributeNameFQN(String fqn) { return AttributeFQN.of(Values.await(Values.run(() -> Generated.NewAttributeNameFQN(Values.encode(fqn), new Library.Options())), null)); }
 public static AttributeFQN newAttributeValueFQN(String fqn) { return AttributeFQN.of(Values.await(Values.run(() -> Generated.NewAttributeValueFQN(Values.encode(fqn), new Library.Options())), null)); }
 public static String keyTypeToPolicyAlgorithm(String keyType) { return Values.decode(Values.await(Values.run(() -> Generated.KeyTypeToPolicyAlgorithm(Values.encode(keyType), new Library.Options())), null)); }
 public static String policyAlgorithmToKeyType(String alg) { return Values.decode(Values.await(Values.run(() -> Generated.PolicyAlgorithmToKeyType(Values.encode(alg), new Library.Options())), null)); }
 public static String version() { return Values.decode(Values.await(Values.run(() -> Generated.Version(new Library.Options())), null)); }
 public static String tdfSpecVersion() { return Values.decode(Values.await(Values.run(() -> Generated.TDFSpecVersion(new Library.Options())), null)); }
 public static List<String> supportedFeatures() { return Values.decode(Values.await(Values.run(() -> Generated.SupportedFeatures(new Library.Options())), null)); }
}
