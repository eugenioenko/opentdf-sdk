"""OpenTDF SDK: the handle API of api-spec.md in Python idiom (snake_case
keyword options, str/bytes, int sizes, one OpenTDFError, sync methods with
async twins). The adapter maps names and errors only; the TDF protocol executes in the generated code.
The platform service clients take and return the protobuf messages of
opentdf_tdf3.protocol, which cross to the generated code as protobuf JSON."""
from dataclasses import dataclass
import asyncio
import importlib
import json
import re
from google.protobuf import json_format, message_factory
from concurrent.futures import Future, TimeoutError as _FutureTimeout
from typing import Any, Awaitable
from . import _generated
from ._generated import rt
from ._generated.rt.runtime.lib_callback_request import ProviderRejected, ProviderRequest
from .services import SERVICES

TOKEN_PROVIDER_NAME = 'access-token'

# Value shapes: (host name, generated name, kind); kinds are 's' str, 'n' int,
# 'b' bool, 'ss' list[str], a shape (nested object) or [shape] (a list).
# Manifest rows use the reference's JSON tags as host names.
_TOKEN_EXCHANGE = (('subject_token', 'SubjectToken', 's'), ('audience', 'Audience', 'ss'))
_CERT_EXCHANGE = (('client_cert_pem', 'ClientCertPEM', 's'), ('client_key_pem', 'ClientKeyPEM', 's'), ('audience', 'Audience', 'ss'))
_TLS = (('client_cert_pem', 'ClientCertPEM', 's'), ('client_key_pem', 'ClientKeyPEM', 's'), ('root_cas_pem', 'RootCAsPEM', 's'), ('audience', 'Audience', 'ss'))
_ENTRY = (('key', 'Key', 's'), ('value', 'Value', 's'))
_PLATFORM_CONFIGURATION = (('entries', 'Entries', [_ENTRY]),)
_OPTIONS = (
    ('client_id', 'ClientID', 's'), ('client_secret', 'ClientSecret', 's'), ('scopes', 'Scopes', 'ss'), ('token_endpoint', 'TokenEndpoint', 's'),
    ('token_exchange', 'TokenExchange', _TOKEN_EXCHANGE), ('cert_exchange', 'CertExchange', _CERT_EXCHANGE), ('token_provider_name', 'TokenProviderName', 's'),
    ('platform_configuration', 'PlatformConfiguration', _PLATFORM_CONFIGURATION), ('validate_connection', 'ValidateConnection', 'b'),
    ('insecure_plaintext', 'InsecurePlaintext', 'b'), ('insecure_skip_verify', 'InsecureSkipVerify', 'b'), ('tls', 'TLS', _TLS), ('unix_socket', 'UnixSocket', 's'),
    ('timeout_millis', 'TimeoutMillis', 'n'), ('core_endpoint', 'CoreEndpoint', 's'), ('policy_endpoint', 'PolicyEndpoint', 's'),
    ('authorization_endpoint', 'AuthorizationEndpoint', 's'), ('entity_resolution_endpoint', 'EntityResolutionEndpoint', 's'), ('wellknown_endpoint', 'WellknownEndpoint', 's'),
    ('session_encryption_rsa_pem', 'SessionEncryptionRSAPEM', 's'), ('session_signer_rsa_pem', 'SessionSignerRSAPEM', 's'), ('dpop_algorithm', 'DPoPAlgorithm', 's'),
    ('dpop_key_pem', 'DPoPKeyPEM', 's'), ('no_kid_in_kao', 'NoKIDInKAO', 'b'), ('fulfillable_obligation_fqns', 'FulfillableObligationFQNs', 'ss'), ('log_level', 'LogLevel', 'n'),
)
_KAS_INFO = (('url', 'URL', 's'), ('public_key', 'PublicKey', 's'), ('kid', 'KID', 's'), ('algorithm', 'Algorithm', 's'), ('default', 'Default', 'b'))
_STATEMENT = (('format', 'Format', 's'), ('schema', 'Schema', 's'), ('value', 'Value', 's'))
_ASSERTION_KEY = (('alg', 'Alg', 's'), ('key', 'Key', 's'))
_ASSERTION_CONFIG = (
    ('id', 'ID', 's'), ('type', 'Type', 's'), ('scope', 'Scope', 's'), ('applies_to_state', 'AppliesToState', 's'), ('statement', 'Statement', _STATEMENT),
    ('signing_key', 'SigningKey', _ASSERTION_KEY),
)
_ASSERTION_KEY_ENTRY = (('assertion_id', 'AssertionID', 's'), ('alg', 'Alg', 's'), ('key', 'Key', 's'))
_ASSERTION_VERIFICATION_KEYS = (('default_key', 'DefaultKey', _ASSERTION_KEY), ('keys', 'Keys', [_ASSERTION_KEY_ENTRY]))
_TDF_OPTIONS = (
    ('attributes', 'Attributes', 'ss'), ('attribute_values', 'AttributeValues', 'ss'), ('disable_autoconfigure', 'DisableAutoconfigure', 'b'),
    ('kas_information', 'KasInformation', [_KAS_INFO]),
    ('wrapping_key_algorithm', 'WrappingKeyAlgorithm', 's'), ('segment_size', 'SegmentSize', 'n'), ('input_size', 'InputSize', 'n'), ('mime_type', 'MimeType', 's'),
    ('metadata', 'Metadata', 's'), ('assertions', 'Assertions', [_ASSERTION_CONFIG]), ('system_metadata_assertion', 'SystemMetadataAssertion', 'b'), ('target_mode', 'TargetMode', 's'),
)
_READER_OPTIONS = (
    ('disable_assertion_verification', 'DisableAssertionVerification', 'b'), ('assertion_verification_keys', 'AssertionVerificationKeys', _ASSERTION_VERIFICATION_KEYS),
    ('kas_allowlist', 'KasAllowlist', 'ss'), ('ignore_allowlist', 'IgnoreAllowlist', 'b'),
    ('max_manifest_size', 'MaxManifestSize', 'n'), ('schema_validation', 'SchemaValidation', 'n'), ('session_key_type', 'SessionKeyType', 's'),
    ('fulfillable_obligation_fqns', 'FulfillableObligationFQNs', 'ss'),
)
_KAS_PUBLIC_KEY_SET = (('keys', 'Keys', [(('pem', 'Pem', 's'), ('kid', 'Kid', 's'), ('alg', 'Alg', 's'))]),)
_ATTRIBUTE_FQN = (('url', 'URL', 's'), ('key', 'Key', 's'))
_SIMPLE_KAS_KEY = (('kas_uri', 'KasURI', 's'), ('public_key', 'PublicKey', (('algorithm', 'Algorithm', 's'), ('kid', 'Kid', 's'), ('pem', 'Pem', 's'))), ('kas_id', 'KasID', 's'))
_ERROR = (
    ('kind', 'Kind', 's'), ('op', 'Op', 's'), ('message', 'Message', 's'), ('http_status', 'HTTPStatus', 'n'), ('connect_code', 'ConnectCode', 's'),
    ('service_message', 'ServiceMessage', 's'), ('kas_url', 'KASURL', 's'), ('required_obligations', 'RequiredObligations', 'ss'), ('assertion_id', 'AssertionID', 's'),
)
_SEGMENT = (('hash', 'Hash', 's'), ('segmentSize', 'Size', 'n'), ('encryptedSegmentSize', 'EncryptedSize', 'n'))
_INTEGRITY = (
    ('rootSignature', 'RootSignature', (('alg', 'Algorithm', 's'), ('sig', 'Signature', 's'))), ('segmentHashAlg', 'SegmentHashAlgorithm', 's'),
    ('segmentSizeDefault', 'DefaultSegmentSize', 'n'), ('encryptedSegmentSizeDefault', 'DefaultEncryptedSegSize', 'n'), ('segments', 'Segments', [_SEGMENT]),
)
_KEY_ACCESS = (
    ('type', 'KeyType', 's'), ('url', 'KasURL', 's'), ('protocol', 'Protocol', 's'), ('wrappedKey', 'WrappedKey', 's'),
    ('policyBinding', 'PolicyBinding', (('alg', 'Alg', 's'), ('hash', 'Hash', 's'))), ('encryptedMetadata', 'EncryptedMetadata', 's'), ('kid', 'KID', 's'),
    ('sid', 'SplitID', 's'), ('schemaVersion', 'SchemaVersion', 's'), ('ephemeralPublicKey', 'EphemeralPublicKey', 's'),
)
_ASSERTION = (
    ('id', 'ID', 's'), ('type', 'Type', 's'), ('scope', 'Scope', 's'), ('appliesToState', 'AppliesToState', 's'), ('statement', 'Statement', _STATEMENT),
    ('binding', 'Binding', (('method', 'Method', 's'), ('signature', 'Signature', 's'))),
)
_MANIFEST = (
    ('encryptionInformation', 'EncryptionInformation', (
        ('type', 'KeyAccessType', 's'), ('policy', 'Policy', 's'), ('keyAccess', 'KeyAccessObjs', [_KEY_ACCESS]),
        ('method', 'Method', (('algorithm', 'Algorithm', 's'), ('iv', 'IV', 's'), ('isStreamable', 'IsStreamable', 'b'))), ('integrityInformation', 'IntegrityInformation', _INTEGRITY),
    )),
    ('payload', 'Payload', (('type', 'Type', 's'), ('url', 'URL', 's'), ('protocol', 'Protocol', 's'), ('mimeType', 'MimeType', 's'), ('isEncrypted', 'IsEncrypted', 'b'))),
    ('assertions', 'Assertions', [_ASSERTION]), ('schemaVersion', 'TDFVersion', 's'),
)
_ATTRIBUTE_OBJECT = (('attribute', 'Attribute', 's'), ('displayName', 'DisplayName', 's'), ('isDefault', 'IsDefault', 'b'), ('pubKey', 'PubKey', 's'), ('kasURL', 'KasURL', 's'))
_POLICY = (('uuid', 'UUID', 's'), ('body', 'Body', (('dataAttributes', 'DataAttributes', [_ATTRIBUTE_OBJECT]), ('dissem', 'Dissem', 'ss'))))


def _invalid():
    raise rt.LibraryFailure('invalid_argument')


def _text(value):
    if type(value) is not str: _invalid()
    try: return value.encode('utf-8', 'strict')
    except UnicodeError: _invalid()


def _in_value(kind, v):
    if kind == 's': return _text(v)
    if kind == 'n':
        if type(v) is not int: _invalid()
        return v
    if kind == 'b':
        if type(v) is not bool: _invalid()
        return v
    if kind == 'ss':
        if type(v) not in (list, tuple): _invalid()
        return [_text(x) for x in v]
    if type(kind) is list:
        if type(v) not in (list, tuple): _invalid()
        return [_to_generated(kind[0], x) for x in v]
    return _to_generated(kind, v)


def _to_generated(shape, value):
    if value is None: return {}
    if type(value) is not dict: _invalid()
    names = {host for host, _, _ in shape}
    unknown = set(value) - names
    if unknown: raise TypeError('unknown option(s): ' + ', '.join(sorted(unknown)))
    out = {}
    for host, gen, kind in shape:
        v = value.get(host)
        if v is None: continue
        out[gen] = _in_value(kind, v)
    return out


def _decode(v):
    return v.decode('utf-8', 'strict') if type(v) is bytes else ''


def _out_value(kind, v):
    if kind == 's': return _decode(v)
    if kind == 'n': return v if type(v) is int else 0
    if kind == 'b': return v is True
    if kind == 'ss': return [_decode(x) for x in (v or ())]
    if type(kind) is list: return [_from_generated(kind[0], x) for x in (v or ())]
    return _from_generated(kind, v)


def _from_generated(shape, value):
    value = value or {}
    return {host: _out_value(kind, value.get(gen)) for host, gen, kind in shape}


class OpenTDFError(Exception):
    """The shared-source Error record (api-spec.md): kind, op, the reference's
    message and the service fields. A boundary failure (canceled, closed,
    invalid_argument, ...) keeps the runtime's kind."""
    def __init__(self, failure):
        f = failure.fields
        if failure.kind == 'source' and type(f.get('Kind')) is bytes:
            record = _from_generated(_ERROR, f)
        else:
            record = {'kind': failure.kind, 'op': '', 'message': 'goalchemy library: ' + failure.kind, 'http_status': 0, 'connect_code': '', 'service_message': '', 'kas_url': '', 'required_obligations': [], 'assertion_id': ''}
        self.kind = record['kind']; self.op = record['op']; self.message = record['message']
        self.http_status = record['http_status']; self.connect_code = record['connect_code']; self.service_message = record['service_message']
        self.kas_url = record['kas_url']; self.required_obligations = tuple(record['required_obligations']); self.assertion_id = record['assertion_id']
        super().__init__(self.message)


@dataclass(frozen=True)
class AccessToken:
    value: str
    scheme: str
    expires_at: int
    confirmation_jkt: str = ''


def _token(token):
    if type(token) is not AccessToken or type(token.expires_at) is not int or not 0 <= token.expires_at < 1 << 63: raise ProviderRejected('provider: invalid token')
    if any(type(v) is not str or len(v) > limit for v, limit in ((token.value, 65536), (token.scheme, 128), (token.confirmation_jkt, 256))): raise ProviderRejected('provider: invalid token')
    try:
        for v in (token.value, token.scheme, token.confirmation_jkt): v.encode('utf-8', 'strict')
    except UnicodeError: raise ProviderRejected('provider: invalid token')
    return json.dumps({'value': token.value, 'scheme': token.scheme, 'expiresAt': str(token.expires_at), 'confirmationJKT': token.confirmation_jkt}, ensure_ascii=False, separators=(',', ':')).encode('utf-8')


@dataclass(frozen=True)
class ConnectRPCConnection:
    """The reference's ConnectRPCConnection: the endpoint a connection reaches."""
    endpoint: str


def _access_token(v):
    v = v or {}
    return AccessToken(_decode(v.get('Value')), _decode(v.get('Scheme')), v.get('ExpiresAt') if type(v.get('ExpiresAt')) is int else 0, _decode(v.get('ConfirmationJKT')))


class AuthClient:
    """The reference's AuthClient: authentication operations of an SDK."""
    def __init__(self, sdk): self._sdk = sdk
    def access_token(self, timeout=None):
        """A valid access token for the SDK's credentials; raises the
        reference's ErrNoAccessTokenSource without credentials."""
        client = _wait(self._sdk._run(lambda: self._sdk._handle.Auth(self._sdk._calls)), timeout)
        try: return _wait(self._sdk._run(lambda: client.AccessToken(self._sdk._calls)), timeout, _access_token)
        finally: _wait(client.close(), None)
    async def access_token_async(self):
        client = await _await(self._sdk._run(lambda: self._sdk._handle.Auth(self._sdk._calls)))
        try: return await _await(self._sdk._run(lambda: client.AccessToken(self._sdk._calls)), _access_token)
        finally: await _await(client.close())


def _message(module, name):
    return getattr(importlib.import_module(module, __package__), name)


def _attributes(values):
    attribute = _message('.protocol.policy.objects_pb2', 'Attribute')
    out = []
    for text in values or ():
        try: out.append(json_format.Parse(_decode(text), attribute(), ignore_unknown_fields=True))
        except json_format.ParseError as e: raise OpenTDFError(rt.LibraryFailure('source', {'Kind': b'transport', 'Op': b'ListAttributes', 'Message': ('unmarshal message: ' + str(e)).encode('utf-8')})) from None
    return out


def _entity(entity):
    if entity is None: return b''
    if getattr(getattr(entity, 'DESCRIPTOR', None), 'full_name', None) != 'authorization.Entity':
        raise TypeError('get_entity_attributes takes an authorization.Entity message')
    return json.dumps(json_format.MessageToDict(entity), separators=(',', ':')).encode('utf-8')


def _tdf_options(options):
    values = options.get('attribute_values')
    if values is None: return options
    for value in values:
        if getattr(getattr(value, 'DESCRIPTOR', None), 'full_name', None) != 'policy.Value':
            raise TypeError('attribute_values takes policy.Value messages')
    return dict(options, attribute_values=[json.dumps(json_format.MessageToDict(v), separators=(',', ':')) for v in values])


def _reader_options(options):
    verification = options.get('assertion_verification_keys')
    if verification is None: return options
    if type(verification) is not dict: _invalid()
    keys = verification.get('keys')
    if keys is None: return options
    if type(keys) is not dict: _invalid()
    entries = []
    for assertion_id, key in keys.items():
        if type(key) is not dict: _invalid()
        entries.append(dict(key, assertion_id=assertion_id))
    return dict(options, assertion_verification_keys=dict(verification, keys=entries))


def _provider(provider):
    def call(request):
        value = provider(request)
        if asyncio.iscoroutine(value):
            async def mapped(): return _token(await value)
            return mapped()
        if type(value) is Future: value = value.result()
        return _token(value)
    return call


def _callbacks(provider):
    if provider is None: return None
    if not callable(provider): _invalid()
    return {'callbacks': {TOKEN_PROVIDER_NAME: _provider(provider)}}


def _wait(operation, timeout, convert=lambda v: v):
    try: return convert(operation.result(timeout))
    except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    except _FutureTimeout:
        operation.cancel()
        try: operation.result()
        except BaseException: pass
        raise OpenTDFError(rt.LibraryFailure('deadline_exceeded')) from None


async def _await(operation, convert=lambda v: v):
    try: return convert(await operation)
    except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None


def _manifest(v): return _from_generated(_MANIFEST, v)


class TDFObject:
    """The reference's TDFObject: the TDF bytes and a handle to its manifest."""
    def __init__(self, data, handle, calls):
        self.bytes = data; self._handle = handle; self._calls = calls
    def manifest(self, timeout=None): return _wait(self._handle.Manifest(self._calls), timeout, _manifest)
    async def manifest_async(self): return await _await(self._handle.Manifest(self._calls), _manifest)
    def size(self, timeout=None): return _wait(self._handle.Size(self._calls), timeout)
    async def size_async(self): return await _await(self._handle.Size(self._calls))
    def close(self, timeout=None): return _wait(self._handle.close(), timeout)
    async def close_async(self): return await _await(self._handle.close())
    def __enter__(self): return self
    def __exit__(self, *exc): self.close(); return False
    async def __aenter__(self): return self
    async def __aexit__(self, *exc): await self.close_async(); return False


class Reader:
    """The reference's Reader over a loaded TDF. Payload bytes stream in
    segments: read, seek, read_at and write_to decrypt on demand, as_file
    is the payload as a binary file-like object. Call init first when the
    SDK uses a token_provider, since file reads carry no callbacks."""
    def __init__(self, handle, calls):
        self._handle = handle; self._calls = calls; self._file = None
    def init(self, timeout=None): return _wait(self._handle.Init(self._calls), timeout)
    async def init_async(self): return await _await(self._handle.Init(self._calls))
    def as_file(self):
        """The decrypted payload as an unbuffered binary file (io.RawIOBase)
        sharing this reader's position; closing it closes the reader."""
        if self._file is None: self._file = self._handle.as_file()
        return self._file
    def read(self, size=-1):
        """Reads up to size bytes of plaintext from the current position (all
        remaining bytes when size is negative); b'' at the end."""
        return self.as_file().readall() if size is None or size < 0 else self.as_file().read(size)
    def seek(self, offset, whence=0, timeout=None):
        """The reference's Seek: moves the plaintext position; whence is
        os.SEEK_SET, SEEK_CUR or SEEK_END."""
        return _wait(self._handle.Seek(offset, whence, self._calls), timeout)
    async def seek_async(self, offset, whence=0): return await _await(self._handle.Seek(offset, whence, self._calls))
    def read_at(self, offset, length, timeout=None):
        """Decrypts length plaintext bytes at offset without moving the position."""
        return _wait(self._handle.ReadAt(offset, length, self._calls), timeout, lambda v: v or b'')
    async def read_at_async(self, offset, length): return await _await(self._handle.ReadAt(offset, length, self._calls), lambda v: v or b'')
    def write_to(self, output, timeout=None):
        """Decrypts the payload from the current position into a writable
        file-like object; returns the bytes written."""
        return _wait(self._write_to(output), timeout)
    async def write_to_async(self, output): return await _await(self._write_to(output))
    def _write_to(self, output):
        try: return self._handle.WriteTo(output, self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def __iter__(self):
        while True:
            chunk = self.read(1 << 20)
            if not chunk: return
            yield chunk
    def manifest(self, timeout=None): return _wait(self._handle.Manifest(self._calls), timeout, _manifest)
    async def manifest_async(self): return await _await(self._handle.Manifest(self._calls), _manifest)
    def policy(self, timeout=None): return _wait(self._handle.Policy(self._calls), timeout, lambda v: _from_generated(_POLICY, v))
    async def policy_async(self): return await _await(self._handle.Policy(self._calls), lambda v: _from_generated(_POLICY, v))
    def data_attributes(self, timeout=None): return _wait(self._handle.DataAttributes(self._calls), timeout, lambda v: _out_value('ss', v))
    async def data_attributes_async(self): return await _await(self._handle.DataAttributes(self._calls), lambda v: _out_value('ss', v))
    def unencrypted_metadata(self, timeout=None): return _wait(self._handle.UnencryptedMetadata(self._calls), timeout, lambda v: v or b'')
    async def unencrypted_metadata_async(self): return await _await(self._handle.UnencryptedMetadata(self._calls), lambda v: v or b'')
    def close(self, timeout=None): return _wait(self._handle.close(), timeout)
    async def close_async(self): return await _await(self._handle.close())
    def __enter__(self): return self
    def __exit__(self, *exc): self.close(); return False
    async def __aenter__(self): return self
    async def __aexit__(self, *exc): await self.close_async(); return False


def _sdk_options(options):
    options = dict(options)
    provider = options.pop('token_provider', None)
    calls = _callbacks(provider)
    if calls is not None: options['token_provider_name'] = TOKEN_PROVIDER_NAME
    configuration = options.pop('platform_configuration', None)
    if configuration is not None:
        if type(configuration) is not dict: _invalid()
        options['platform_configuration'] = {'entries': [{'key': k, 'value': v if type(v) is str else json.dumps(v, separators=(',', ':'))} for k, v in configuration.items()]}
    return _to_generated(_OPTIONS, options), calls


def _new(platform_endpoint, options):
    generated, calls = _sdk_options(options)
    return _generated.New(_text(platform_endpoint), generated, calls), calls


class SDK:
    """The reference's SDK handle: SDK(endpoint, **options) discovers the
    platform configuration and the token endpoint; create_async is the
    coroutine twin."""
    def __init__(self, platform_endpoint, *, timeout=None, _handle=None, _calls=None, **options):
        if _handle is not None:
            self._handle = _handle; self._calls = _calls; return
        try: operation, calls = _new(platform_endpoint, options)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
        self._handle = _wait(operation, timeout); self._calls = calls
    @classmethod
    async def create_async(cls, platform_endpoint, **options):
        try: operation, calls = _new(platform_endpoint, options)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
        return cls(platform_endpoint, _handle=await _await(operation), _calls=calls)

    def _encrypt(self, plaintext, options):
        try: return self._handle.EncryptBytes(rt.library_snapshot_bytes(plaintext), _to_generated(_TDF_OPTIONS, _tdf_options(options)), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def _object(self, result): return TDFObject(result[0] or b'', result[1], self._calls)
    def create_tdf(self, plaintext, *, timeout=None, **options):
        """The reference's CreateTDF over bytes: a TDFObject with the TDF bytes."""
        return _wait(self._encrypt(plaintext, options), timeout, self._object)
    async def create_tdf_async(self, plaintext, **options): return await _await(self._encrypt(plaintext, options), self._object)
    def encrypt_bytes(self, plaintext, *, timeout=None, **options):
        """create_tdf without keeping the handle: the TDF bytes only."""
        with self.create_tdf(plaintext, timeout=timeout, **options) as obj: return obj.bytes
    async def encrypt_bytes_async(self, plaintext, **options):
        async with await self.create_tdf_async(plaintext, **options) as obj: return obj.bytes

    def _encrypt_to(self, output, plaintext, options):
        try: return self._handle.CreateTDF(output, plaintext, _to_generated(_TDF_OPTIONS, _tdf_options(options)), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def _streamed(self, handle): return TDFObject(b'', handle, self._calls)
    def encrypt_to(self, output, plaintext, *, timeout=None, **options):
        """The reference's CreateTDF over streams: encrypts the readable
        file-like object (or bytes) plaintext into the writable file-like
        object output in segments and returns the TDFObject (its bytes are
        empty). A seekable or sized input (input_size) writes a ZIP32 archive
        when it fits; an unknown size writes ZIP64."""
        return _wait(self._encrypt_to(output, plaintext, options), timeout, self._streamed)
    async def encrypt_to_async(self, output, plaintext, **options): return await _await(self._encrypt_to(output, plaintext, options), self._streamed)

    def _load(self, ciphertext, options):
        source = rt.library_snapshot_bytes(ciphertext) if isinstance(ciphertext, (bytes, bytearray, memoryview)) else ciphertext
        try: return self._handle.LoadTDF(source, _to_generated(_READER_OPTIONS, _reader_options(options)), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def load_tdf(self, ciphertext, *, timeout=None, **options):
        """The reference's LoadTDF over bytes or a seekable readable file-like
        object, which the Reader keeps open and reads segment by segment."""
        return _wait(self._load(ciphertext, options), timeout, lambda h: Reader(h, self._calls))
    async def load_tdf_async(self, ciphertext, **options): return await _await(self._load(ciphertext, options), lambda h: Reader(h, self._calls))

    def _decrypt(self, ciphertext, options):
        try: return self._handle.DecryptBytes(rt.library_snapshot_bytes(ciphertext), _to_generated(_READER_OPTIONS, _reader_options(options)), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def decrypt_bytes(self, ciphertext, *, timeout=None, **options): return _wait(self._decrypt(ciphertext, options), timeout, lambda v: v or b'')
    async def decrypt_bytes_async(self, ciphertext, **options): return await _await(self._decrypt(ciphertext, options), lambda v: v or b'')

    def _decrypt_to(self, output, ciphertext, options):
        source = rt.library_snapshot_bytes(ciphertext) if isinstance(ciphertext, (bytes, bytearray, memoryview)) else ciphertext
        try: return self._handle.DecryptTo(output, source, _to_generated(_READER_OPTIONS, _reader_options(options)), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def decrypt_to(self, output, ciphertext, *, timeout=None, **options):
        """The reference's DecryptTo: decrypts a seekable readable file-like
        object (or bytes) into the writable file-like object output in segments."""
        return _wait(self._decrypt_to(output, ciphertext, options), timeout)
    async def decrypt_to_async(self, output, ciphertext, **options): return await _await(self._decrypt_to(output, ciphertext, options))
    def _decrypt_file(self, input_path, output_path, options):
        try: return self._handle.DecryptFile(_text(input_path), _text(output_path), _to_generated(_READER_OPTIONS, _reader_options(options)), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def decrypt_file(self, input_path, output_path, *, timeout=None, **options):
        """The reference's DecryptFile: decrypts the TDF at input_path into a
        temporary file beside output_path and renames it into place, so a
        failure leaves any existing output untouched."""
        return _wait(self._decrypt_file(input_path, output_path, options), timeout)
    async def decrypt_file_async(self, input_path, output_path, **options): return await _await(self._decrypt_file(input_path, output_path, options))

    def is_healthy(self, timeout=None): return _wait(self._handle.IsHealthy(self._calls), timeout)
    async def is_healthy_async(self): return await _await(self._handle.IsHealthy(self._calls))
    def _configuration(self, v): return {e['key']: e['value'] for e in _from_generated(_PLATFORM_CONFIGURATION, v)['entries']}
    def platform_configuration(self, timeout=None): return _wait(self._handle.PlatformConfiguration(self._calls), timeout, self._configuration)
    async def platform_configuration_async(self): return await _await(self._handle.PlatformConfiguration(self._calls), self._configuration)
    def get_base_key(self, timeout=None): return _wait(self._handle.GetBaseKey(self._calls), timeout, lambda v: _from_generated(_SIMPLE_KAS_KEY, v))
    async def get_base_key_async(self): return await _await(self._handle.GetBaseKey(self._calls), lambda v: _from_generated(_SIMPLE_KAS_KEY, v))
    def _store(self, url, keys):
        try: return self._handle.StoreKASKeys(_text(url), _to_generated(_KAS_PUBLIC_KEY_SET, keys), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def store_kas_keys(self, url, keys, timeout=None): return _wait(self._store(url, keys), timeout)
    async def store_kas_keys_async(self, url, keys): return await _await(self._store(url, keys))
    def _service_call(self, service, method, request):
        try: return self._handle.Call(_text(service), _text(method), _text(request), self._calls)
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def call(self, service, method, request, timeout=None):
        """Sends one unary request to a platform service method, such as
        ('policy.attributes.AttributesService', 'ListAttributes'), with the
        request and reply in protobuf JSON: the shared source's SDK.Call."""
        return _wait(self._service_call(service, method, request), timeout, _decode)
    async def call_async(self, service, method, request): return await _await(self._service_call(service, method, request), _decode)
    def _run(self, start):
        try: return start()
        except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None
    def auth(self):
        """The reference's Auth: the SDK's authentication operations."""
        return AuthClient(self)
    def conn(self, timeout=None):
        """The reference's Conn: the endpoint of the core services."""
        return _wait(self._run(lambda: self._handle.Conn(self._calls)), timeout, lambda v: ConnectRPCConnection(_decode((v or {}).get('Endpoint'))))
    async def conn_async(self): return await _await(self._run(lambda: self._handle.Conn(self._calls)), lambda v: ConnectRPCConnection(_decode((v or {}).get('Endpoint'))))
    def _list(self, namespace): return self._run(lambda: self._handle.ListAttributesJSON([] if namespace is None else [_text(namespace)], self._calls))
    def list_attributes(self, namespace=None, *, timeout=None):
        """The reference's ListAttributes: every active attribute (policy.Attribute),
        following the pages, optionally in one namespace (name or id)."""
        return _wait(self._list(namespace), timeout, _attributes)
    async def list_attributes_async(self, namespace=None): return await _await(self._list(namespace), _attributes)
    def _entitlements(self, entity): return self._run(lambda: self._handle.GetEntityAttributesJSON(_entity(entity), self._calls))
    def get_entity_attributes(self, entity, *, timeout=None):
        """The reference's GetEntityAttributes: the attribute value FQNs entitled to an authorization.Entity."""
        return _wait(self._entitlements(entity), timeout, lambda v: _out_value('ss', v))
    async def get_entity_attributes_async(self, entity): return await _await(self._entitlements(entity), lambda v: _out_value('ss', v))
    def _validate(self, fqns): return self._run(lambda: self._handle.ValidateAttributes(_in_value('ss', fqns), self._calls))
    def validate_attributes(self, fqns, *, timeout=None):
        """The reference's ValidateAttributes: raises ErrAttributeNotFound naming the missing value FQNs."""
        return _wait(self._validate(fqns), timeout)
    async def validate_attributes_async(self, fqns): return await _await(self._validate(fqns))
    def attribute_exists(self, fqn, *, timeout=None):
        """The reference's AttributeExists for an attribute FQN (https://<namespace>/attr/<name>)."""
        return _wait(self._run(lambda: self._handle.AttributeExists(_text(fqn), self._calls)), timeout)
    async def attribute_exists_async(self, fqn): return await _await(self._run(lambda: self._handle.AttributeExists(_text(fqn), self._calls)))
    def attribute_value_exists(self, fqn, *, timeout=None):
        """The reference's AttributeValueExists for a value FQN (.../attr/<name>/value/<value>)."""
        return _wait(self._run(lambda: self._handle.AttributeValueExists(_text(fqn), self._calls)), timeout)
    async def attribute_value_exists_async(self, fqn): return await _await(self._run(lambda: self._handle.AttributeValueExists(_text(fqn), self._calls)))
    def close(self, timeout=None): return _wait(self._handle.close(), timeout)
    async def close_async(self): return await _await(self._handle.close())
    def __enter__(self): return self
    def __exit__(self, *exc): self.close(); return False
    async def __aenter__(self): return self
    async def __aexit__(self, *exc): await self.close_async(); return False


def _snake(name):
    return '_'.join(w.lower() for w in re.findall(r'[A-Z]{2,}s?(?=[A-Z]|$)|[A-Z][a-z0-9]*', name))


def _service_method(service, method):
    response_class = message_factory.GetMessageClass(method.output_type)
    request_class = message_factory.GetMessageClass(method.input_type)
    def encode(request):
        if request is None: request = request_class()
        if getattr(getattr(request, 'DESCRIPTOR', None), 'full_name', None) != method.input_type.full_name:
            raise TypeError(method.name + ' takes a ' + method.input_type.full_name + ' message')
        return json.dumps(json_format.MessageToDict(request), separators=(',', ':'))
    def decode(text):
        response = response_class()
        json_format.Parse(_decode(text), response, ignore_unknown_fields=True)
        return response
    def call(self, request=None, *, timeout=None):
        return _wait(self._sdk._service_call(service, method.name, encode(request)), timeout, decode)
    async def call_async(self, request=None):
        return await _await(self._sdk._service_call(service, method.name, encode(request)), decode)
    call.__doc__ = 'The reference\'s ' + method.name + ' of ' + service + ': ' + method.input_type.name + ' in, ' + method.output_type.name + ' out.'
    call_async.__doc__ = 'The coroutine twin of ' + _snake(method.name) + '.'
    return call, call_async


def _service_client(accessor, module, service):
    descriptor = importlib.import_module(module).DESCRIPTOR.services_by_name[service.rsplit('.', 1)[1]]
    members = {'__doc__': 'The ' + service + ' client: one method per unary RPC taking and returning its protobuf messages, with *_async twins.',
               '__init__': lambda self, sdk: setattr(self, '_sdk', sdk), 'descriptor': descriptor}
    for method in descriptor.methods:
        call, call_async = _service_method(service, method)
        members[_snake(method.name)] = call
        members[_snake(method.name) + '_async'] = call_async
    return type(''.join(w.capitalize() for w in accessor.split('_')) + 'Client', (), members)


for _accessor, _module, _service in SERVICES:
    setattr(SDK, _accessor, property((lambda client: lambda self: client(self))(_service_client(_accessor, _module, _service)),
                                    doc='The ' + _service + ' client of this SDK.'))


def _free(call, convert=lambda v: v, timeout=None):
    try: return _wait(call(), timeout, convert)
    except rt.LibraryFailure as failure: raise OpenTDFError(failure) from None


def is_valid_tdf(data, timeout=None): return _free(lambda: _generated.IsValidTdf(rt.library_snapshot_bytes(data)), timeout=timeout)
def get_tdf_type(data, timeout=None): return _free(lambda: _generated.GetTdfType(rt.library_snapshot_bytes(data)), _decode, timeout)
def is_platform_endpoint_malformed(endpoint): return _free(lambda: _generated.IsPlatformEndpointMalformed(_text(endpoint)))
def new_attribute_name_fqn(fqn):
    """The reference's NewAttributeNameFQN: {'url', 'key'}, or OpenTDFError (invalid type)."""
    return _free(lambda: _generated.NewAttributeNameFQN(_text(fqn)), lambda v: _from_generated(_ATTRIBUTE_FQN, v))
def new_attribute_value_fqn(fqn):
    """The reference's NewAttributeValueFQN: {'url', 'key'}, or OpenTDFError (invalid type)."""
    return _free(lambda: _generated.NewAttributeValueFQN(_text(fqn)), lambda v: _from_generated(_ATTRIBUTE_FQN, v))
def key_type_to_policy_algorithm(key_type): return _free(lambda: _generated.KeyTypeToPolicyAlgorithm(_text(key_type)), _decode)
def policy_algorithm_to_key_type(alg): return _free(lambda: _generated.PolicyAlgorithmToKeyType(_text(alg)), _decode)
def version(): return _free(_generated.Version, _decode)
def tdf_spec_version(): return _free(_generated.TDFSpecVersion, _decode)
def supported_features(): return _free(_generated.SupportedFeatures, lambda v: _out_value('ss', v))
