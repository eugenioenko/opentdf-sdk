export interface AccessToken { value: string; scheme: string; expiresAt: bigint; confirmationJKT?: string; }
export type TokenProvider = (signal: AbortSignal) => Promise<AccessToken>;
export const TokenProviderName = 'access-token';

export interface TokenExchange { subjectToken: string; audience?: string[]; }
export interface CertExchange { clientCertPem: string; clientKeyPem: string; audience?: string[]; }
export interface TLSOptions { clientCertPem?: string; clientKeyPem?: string; rootCasPem?: string; audience?: string[]; }
export interface Options {
  clientId?: string; clientSecret?: string; scopes?: string[]; tokenEndpoint?: string;
  tokenExchange?: TokenExchange; certExchange?: CertExchange; tokenProvider?: TokenProvider;
  platformConfiguration?: Record<string, unknown>; validateConnection?: boolean;
  insecurePlaintext?: boolean; insecureSkipVerify?: boolean; tls?: TLSOptions; unixSocket?: string; timeoutMillis?: number;
  coreEndpoint?: string; policyEndpoint?: string; authorizationEndpoint?: string; entityResolutionEndpoint?: string; wellknownEndpoint?: string;
  sessionEncryptionRsaPem?: string; sessionSignerRsaPem?: string; dpopAlgorithm?: SigningAlgorithm; dpopKeyPem?: string; noKidInKao?: boolean;
  fulfillableObligationFqns?: string[]; logLevel?: number;
}
export interface KASInfo { url: string; publicKey?: string; kid?: string; algorithm?: KeyType | string; default?: boolean; }
export interface Statement { format?: string; schema?: string; value?: string; }
/** The reference's AssertionKey: an HS256 secret as text, or a PEM block for RS256. */
export type AssertionKeyAlg = 'HS256' | 'RS256';
export interface AssertionKey { alg: AssertionKeyAlg | string; key: string; }
/** WithAssertions; an absent signingKey signs with HS256 over the payload key. */
export interface AssertionConfig { id: string; type: string; scope: string; appliesToState?: string; statement: Statement; signingKey?: AssertionKey; }
/** WithAssertionVerificationKeys: keys by assertion id, with a default for the rest. */
export interface AssertionVerificationKeys { defaultKey?: AssertionKey; keys?: Record<string, AssertionKey>; }
export interface TDFOptions {
  /** WithDataAttributes. */
  attributes?: string[];
  /** WithDataAttributeValues: values with their definitions, read offline instead of looked up; they replace attributes. */
  attributeValues?: (MessageInitShape<typeof ValueSchema> | Value)[];
  disableAutoconfigure?: boolean; kasInformation?: KASInfo[]; wrappingKeyAlgorithm?: KeyType | string;
  segmentSize?: number; inputSize?: number; mimeType?: string; metadata?: string; assertions?: AssertionConfig[];
  systemMetadataAssertion?: boolean; targetMode?: string;
}
export interface ReaderOptions {
  disableAssertionVerification?: boolean; assertionVerificationKeys?: AssertionVerificationKeys; kasAllowlist?: string[]; ignoreAllowlist?: boolean; maxManifestSize?: number;
  schemaValidation?: number; sessionKeyType?: KeyType | string; fulfillableObligationFqns?: string[];
}
export interface CallOptions { signal?: AbortSignal; }

export interface Segment { hash: string; segmentSize: number; encryptedSegmentSize: number; }
export interface RootSignature { alg: string; sig: string; }
export interface IntegrityInformation { rootSignature: RootSignature; segmentHashAlg: string; segmentSizeDefault: number; encryptedSegmentSizeDefault: number; segments: Segment[]; }
export interface PolicyBinding { alg: string; hash: string; }
export interface KeyAccess { type: string; url: string; protocol: string; wrappedKey: string; policyBinding: PolicyBinding; encryptedMetadata: string; kid: string; sid: string; schemaVersion: string; ephemeralPublicKey: string; }
export interface Method { algorithm: string; iv: string; isStreamable: boolean; }
export interface EncryptionInformation { type: string; policy: string; keyAccess: KeyAccess[]; method: Method; integrityInformation: IntegrityInformation; }
export interface Payload { type: string; url: string; protocol: string; mimeType: string; isEncrypted: boolean; }
export interface Binding { method: string; signature: string; }
export interface Assertion { id: string; type: string; scope: string; appliesToState: string; statement: Statement; binding: Binding; }
export interface Manifest { encryptionInformation: EncryptionInformation; payload: Payload; assertions: Assertion[]; schemaVersion: string; }
export interface AttributeObject { attribute: string; displayName: string; isDefault: boolean; pubKey: string; kasURL: string; }
export interface PolicyObject { uuid: string; body: { dataAttributes: AttributeObject[]; dissem: string[] }; }
export interface SimpleKasKey { kasUri: string; publicKey: { algorithm: string; kid: string; pem: string }; kasId: string; }
export interface KasPublicKey { pem: string; kid: string; alg: string; }
export interface KasPublicKeySet { keys: KasPublicKey[]; }
/** The reference's ConnectRPCConnection: the endpoint a connection reaches. */
export interface ConnectRPCConnection { endpoint: string; }

// OpenTDFError carries the shared-source Error record (api-spec.md): kind,
// op, the reference's message and the service fields. A boundary failure
// (canceled, closed, invalid_argument, ...) keeps the runtime's kind.
export class OpenTDFError extends Error {
  readonly kind: ErrorKind;
  readonly op: string;
  readonly httpStatus: number;
  readonly connectCode: string;
  readonly serviceMessage: string;
  readonly kasUrl: string;
  readonly requiredObligations: string[];
  readonly assertionId: string;
  constructor(error: generated.LibraryError) {
    const f = error.fields;
    const record = error.kind === 'source' && typeof f.Kind === 'string'
      ? fromGenerated(errorShape, f)
      : { kind: error.kind, op: '', message: 'goalchemy library: ' + error.kind, httpStatus: 0, connectCode: '', serviceMessage: '', kasUrl: '', requiredObligations: [], assertionId: '' };
    super(record.message as string, error.cause === undefined ? undefined : { cause: error.cause });
    this.name = 'OpenTDFError';
    this.kind = record.kind as string;
    this.op = record.op as string;
    this.httpStatus = record.httpStatus as number;
    this.connectCode = record.connectCode as string;
    this.serviceMessage = record.serviceMessage as string;
    this.kasUrl = record.kasUrl as string;
    this.requiredObligations = record.requiredObligations as string[];
    this.assertionId = record.assertionId as string;
  }
}
async function guard<T>(run: () => Promise<T>): Promise<T> {
