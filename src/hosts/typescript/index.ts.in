  manifest(call: CallOptions = {}): Promise<Manifest> {
    return guard(async () => fromGenerated(manifestShape, await this.#handle.Manifest(this.#options(call))) as unknown as Manifest);
  }
  policy(call: CallOptions = {}): Promise<PolicyObject> {
    return guard(async () => fromGenerated(policyShape, await this.#handle.Policy(this.#options(call))) as unknown as PolicyObject);
  }
  dataAttributes(call: CallOptions = {}): Promise<string[]> {
    return guard(async () => outValue('ss', await this.#handle.DataAttributes(this.#options(call))) as string[]);
  }
  unencryptedMetadata(call: CallOptions = {}): Promise<Uint8Array> {
    return guard(async () => (await this.#handle.UnencryptedMetadata(this.#options(call))) ?? new Uint8Array());
  }
  close(): Promise<void> { return guard(() => this.#handle.close()); }
  [Symbol.asyncDispose](): Promise<void> { return this.close(); }
}

const connectCodes: Record<string, Code> = {
  canceled: Code.Canceled, unknown: Code.Unknown, invalid_argument: Code.InvalidArgument, deadline_exceeded: Code.DeadlineExceeded,
  not_found: Code.NotFound, already_exists: Code.AlreadyExists, permission_denied: Code.PermissionDenied, resource_exhausted: Code.ResourceExhausted,
  failed_precondition: Code.FailedPrecondition, aborted: Code.Aborted, out_of_range: Code.OutOfRange, unimplemented: Code.Unimplemented,
  internal: Code.Internal, unavailable: Code.Unavailable, data_loss: Code.DataLoss, unauthenticated: Code.Unauthenticated,
};
const kindCodes: Record<string, Code> = { canceled: Code.Canceled, deadline_exceeded: Code.DeadlineExceeded, auth: Code.Unauthenticated, invalid_input: Code.InvalidArgument };

/**
 * The ConnectError a Connect-ES client sees for a failed call: the service's
 * code and message when the service answered, otherwise a code for the SDK
 * error's kind. The OpenTDFError is the cause.
 */
function connectError(e: unknown): ConnectError {
  if (!(e instanceof OpenTDFError)) return ConnectError.from(e);
  const code = connectCodes[e.connectCode] ?? kindCodes[e.kind] ?? Code.Unavailable;
  return new ConnectError(e.connectCode ? e.serviceMessage : e.message, code, undefined, undefined, e);
}

function callSignal(signal: AbortSignal | undefined, timeoutMs: number | undefined): AbortSignal | undefined {
  if (timeoutMs === undefined || timeoutMs <= 0) return signal;
  const timeout = AbortSignal.timeout(timeoutMs);
  return signal ? AbortSignal.any([signal, timeout]) : timeout;
}

/**
 * A Connect-ES Transport whose unary calls go through SDK.call, the SDK's
 * authenticated transport: messages cross as protobuf JSON, unknown fields
 * in replies are ignored. Request headers are not forwarded; streaming
 * methods are unimplemented, as the platform services have none.
 */
function sdkTransport(sdk: SDK): Transport {
  return {
    async unary<I extends DescMessage, O extends DescMessage>(method: DescMethodUnary<I, O>, signal: AbortSignal | undefined, timeoutMs: number | undefined, _header: HeadersInit | undefined, input: MessageInitShape<I>, _contextValues?: ContextValues): Promise<UnaryResponse<I, O>> {
      try {
        const request = toJsonString(method.input, create(method.input, input));
        const response = await sdk.call(method.parent.typeName, method.name, request, { signal: callSignal(signal, timeoutMs) });
        const message = fromJsonString(method.output, response, { ignoreUnknownFields: true });
        return { stream: false, service: method.parent, method, header: new Headers(), message, trailer: new Headers() };
      } catch (e) {
        throw connectError(e);
      }
    },
    async stream<I extends DescMessage, O extends DescMessage>(method: DescMethodStreaming<I, O>): Promise<StreamResponse<I, O>> {
      throw new ConnectError(method.parent.typeName + '/' + method.name + ': streaming methods are not supported', Code.Unimplemented);
    },
  };
}

/** The reference's AuthClient: authentication operations of an SDK. */
export class AuthClient {
  readonly #handle: generated.SDK;
  readonly #calls: Callbacks | undefined;
  /** @internal */
  constructor(handle: generated.SDK, calls: Callbacks | undefined) {
    this.#handle = handle;
    this.#calls = calls;
  }
  /**
   * A valid access token for the SDK's credentials; fails with the
   * reference's ErrNoAccessTokenSource without credentials.
   */
  accessToken(call: CallOptions = {}): Promise<AccessToken> {
    return guard(async () => {
      const options = { signal: call.signal, callbacks: this.#calls };
      const client = await this.#handle.Auth(options);
      if (client === null) throw new Error('invalid generated result');
      try {
        const token = await client.AccessToken(options);
        const out: AccessToken = { value: decode(token.Value), scheme: decode(token.Scheme), expiresAt: typeof token.ExpiresAt === 'bigint' ? token.ExpiresAt : 0n };
        if (token.ConfirmationJKT) out.confirmationJKT = decode(token.ConfirmationJKT);
        return out;
      } finally {
        await client.close();
      }
    });
  }
}

/**
 * The reference's SDK handle; create it with SDK.create. The platform service
 * clients (attributes, namespaces, ...) are Connect-ES clients over
 * sdk.transport.
 */
export interface SDK extends PlatformServices {}
export class SDK {
  readonly #handle: generated.SDK;
  readonly #calls: Callbacks | undefined;
  /** A Connect-ES Transport over the SDK's authenticated transport: createClient(Service, sdk.transport). */
  readonly transport: Transport;
  /** @internal */
  constructor(handle: generated.SDK, calls: Callbacks | undefined) {
    this.#handle = handle;
    this.#calls = calls;
    this.transport = sdkTransport(this);
    Object.assign(this, platformServices(this.transport));
  }
  /**
   * Sends one unary request to a platform service method, such as
   * ('policy.attributes.AttributesService', 'ListAttributes'), with the
   * request and reply in protobuf JSON: the shared source's SDK.Call.
   */
  call(service: string, method: string, request: string, call: CallOptions = {}): Promise<string> {
    return guard(async () => {
      for (const v of [service, method, request]) if (typeof v !== 'string') throw new generated.LibraryError('invalid_argument');
      return decode(await this.#handle.Call(encode(service), encode(method), encode(request), this.#options(call)));
    });
  }
  /** The reference's New: discovers the platform configuration and the token endpoint. */
  static create(platformEndpoint: string, options: Options = {}, call: CallOptions = {}): Promise<SDK> {
    return guard(async () => {
      if (typeof platformEndpoint !== 'string') throw new generated.LibraryError('invalid_argument');
      const calls = options.tokenProvider ? providerCallbacks(options.tokenProvider) : undefined;
      const handle = await generated.New(encode(platformEndpoint), generatedOptions(options), { signal: call.signal, callbacks: calls });
      if (handle === null) throw new Error('invalid generated result');
      return new SDK(handle, calls);
    });
  }
  #options(call: CallOptions): generated.CallOptions { return { signal: call.signal, callbacks: this.#calls }; }
  /** The reference's CreateTDF over bytes: the TDF bytes with their TDFObject handle. */
  createTdf(plaintext: Uint8Array, options: TDFOptions = {}, call: CallOptions = {}): Promise<TDFObject> {
    return guard(async () => {
      const [data, object] = await this.#handle.EncryptBytes(bytes(plaintext), generatedTdfOptions(options), this.#options(call));
      if (data === null || object === null) throw new Error('invalid generated result');
      return new TDFObject(data, object, this.#calls);
    });
  }
  /** createTdf without keeping the handle: the TDF bytes only. */
  async encryptBytes(plaintext: Uint8Array, options: TDFOptions = {}, call: CallOptions = {}): Promise<Uint8Array> {
    const object = await this.createTdf(plaintext, options, call);
    await object.close();
    return object.bytes;
  }
  loadTdf(ciphertext: Uint8Array, options: ReaderOptions = {}, call: CallOptions = {}): Promise<Reader> {
    return guard(async () => {
      const handle = await this.#handle.LoadTDF(bytes(ciphertext), generatedReaderOptions(options), this.#options(call));
      if (handle === null) throw new Error('invalid generated result');
      return new Reader(handle, this.#calls);
    });
  }
  decryptBytes(ciphertext: Uint8Array, options: ReaderOptions = {}, call: CallOptions = {}): Promise<Uint8Array> {
    return guard(async () => (await this.#handle.DecryptBytes(bytes(ciphertext), generatedReaderOptions(options), this.#options(call))) ?? new Uint8Array());
  }
  isHealthy(call: CallOptions = {}): Promise<boolean> { return guard(() => this.#handle.IsHealthy(this.#options(call))); }
  platformConfiguration(call: CallOptions = {}): Promise<Record<string, string>> {
    return guard(async () => {
      const configuration = fromGenerated(platformConfigurationShape, await this.#handle.PlatformConfiguration(this.#options(call))) as { entries: { key: string; value: string }[] };
      const out: Record<string, string> = {};
      for (const entry of configuration.entries) out[entry.key] = entry.value;
      return out;
    });
  }
  getBaseKey(call: CallOptions = {}): Promise<SimpleKasKey> {
    return guard(async () => fromGenerated(simpleKasKeyShape, await this.#handle.GetBaseKey(this.#options(call))) as unknown as SimpleKasKey);
  }
  storeKasKeys(url: string, keys: KasPublicKeySet, call: CallOptions = {}): Promise<void> {
    return guard(() => this.#handle.StoreKASKeys(inValue('s', url) as string, toGenerated(kasPublicKeySetShape, keys) as generated.KasPublicKeySet, this.#options(call)));
  }
  /** The reference's Auth: the SDK's authentication operations. */
  auth(): AuthClient { return new AuthClient(this.#handle, this.#calls); }
  /** The reference's Conn: the endpoint of the core services. */
  conn(call: CallOptions = {}): Promise<ConnectRPCConnection> {
    return guard(async () => ({ endpoint: decode((await this.#handle.Conn(this.#options(call))).Endpoint) }));
  }
  /**
   * The reference's ListAttributes: every active attribute, following the
   * pages, optionally in one namespace (name or id).
   */
  listAttributes(namespace?: string, call: CallOptions = {}): Promise<Attribute[]> {
    return guard(async () => {
      const filter = namespace === undefined ? [] : [inValue('s', namespace) as string];
      const out = await this.#handle.ListAttributesJSON(filter, this.#options(call));
      return (out ?? []).map(json => {
        try {
          return fromJsonString(AttributeSchema, decode(json), { ignoreUnknownFields: true });
        } catch (e) {
          throw new generated.LibraryError('source', { Kind: encode('transport'), Op: encode('ListAttributes'), Message: encode('unmarshal message: ' + (e as Error).message) });
        }
      });
    });
  }
  /** The reference's GetEntityAttributes: the attribute value FQNs entitled to an entity. */
  getEntityAttributes(entity: MessageInitShape<typeof EntitySchema> | Entity, call: CallOptions = {}): Promise<string[]> {
    return guard(async () => {
      if (entity === null || entity === undefined) throw new generated.LibraryError('invalid_argument');
      const request = toJsonString(EntitySchema, create(EntitySchema, entity));
      return outValue('ss', await this.#handle.GetEntityAttributesJSON(encode(request), this.#options(call))) as string[];
    });
  }
  /** The reference's ValidateAttributes: fails with ErrAttributeNotFound naming the missing value FQNs. */
  validateAttributes(fqns: string[], call: CallOptions = {}): Promise<void> {
    return guard(() => this.#handle.ValidateAttributes(inValue('ss', fqns) as string[], this.#options(call)));
  }
  /** The reference's AttributeExists for an attribute FQN (https://<namespace>/attr/<name>). */
  attributeExists(fqn: string, call: CallOptions = {}): Promise<boolean> {
    return guard(() => this.#handle.AttributeExists(inValue('s', fqn) as string, this.#options(call)));
  }
  /** The reference's AttributeValueExists for a value FQN (.../attr/<name>/value/<value>). */
  attributeValueExists(fqn: string, call: CallOptions = {}): Promise<boolean> {
    return guard(() => this.#handle.AttributeValueExists(inValue('s', fqn) as string, this.#options(call)));
  }
  close(): Promise<void> { return guard(() => this.#handle.close()); }
  [Symbol.asyncDispose](): Promise<void> { return this.close(); }
}

export function isValidTdf(data: Uint8Array, call: CallOptions = {}): Promise<boolean> {
  return guard(() => generated.IsValidTdf(bytes(data), { signal: call.signal }));
}
export function getTdfType(data: Uint8Array, call: CallOptions = {}): Promise<string> {
  return guard(async () => decode(await generated.GetTdfType(bytes(data), { signal: call.signal })));
}
export function isPlatformEndpointMalformed(endpoint: string): Promise<boolean> {
  return guard(() => generated.IsPlatformEndpointMalformed(inValue('s', endpoint) as string));
}
/** The reference's AttributeNameFQN and AttributeValueFQN: the FQN as given and its lower-case key. */
export interface AttributeFQN { url: string; key: string; }
export function newAttributeNameFqn(fqn: string): Promise<AttributeFQN> {
  return guard(async () => fromGenerated(attributeFqnShape, await generated.NewAttributeNameFQN(inValue('s', fqn) as string)) as unknown as AttributeFQN);
}
export function newAttributeValueFqn(fqn: string): Promise<AttributeFQN> {
  return guard(async () => fromGenerated(attributeFqnShape, await generated.NewAttributeValueFQN(inValue('s', fqn) as string)) as unknown as AttributeFQN);
}
export function keyTypeToPolicyAlgorithm(keyType: string): Promise<string> {
  return guard(async () => decode(await generated.KeyTypeToPolicyAlgorithm(inValue('s', keyType) as string)));
}
export function policyAlgorithmToKeyType(alg: string): Promise<string> {
  return guard(async () => decode(await generated.PolicyAlgorithmToKeyType(inValue('s', alg) as string)));
}
export function version(): Promise<string> { return guard(async () => decode(await generated.Version())); }
export function tdfSpecVersion(): Promise<string> { return guard(async () => decode(await generated.TDFSpecVersion())); }
export function supportedFeatures(): Promise<string[]> {
  return guard(async () => outValue('ss', await generated.SupportedFeatures()) as string[]);
}
