  if (options === null || typeof options !== 'object') throw new generated.LibraryError('invalid_argument');
  const { tokenProvider, platformConfiguration, ...rest } = options;
  const value: Record<string, unknown> = { ...rest };
  if (tokenProvider !== undefined) {
    if (typeof tokenProvider !== 'function') throw new generated.LibraryError('invalid_argument');
    value.tokenProviderName = TokenProviderName;
  }
  if (platformConfiguration !== undefined) value.platformConfiguration = platformConfigurationEntries(platformConfiguration);
  return toGenerated(optionsShape, value) as generated.Options;
}

/** The reference's TDFObject: the TDF bytes and a handle to its manifest. */
export class TDFObject {
  readonly bytes: Uint8Array;
  readonly #handle: generated.TDFObject;
  readonly #calls: Callbacks | undefined;
  /** @internal */
  constructor(bytes: Uint8Array, handle: generated.TDFObject, calls: Callbacks | undefined) {
    this.bytes = bytes;
    this.#handle = handle;
    this.#calls = calls;
  }
  manifest(call: CallOptions = {}): Promise<Manifest> {
    return guard(async () => fromGenerated(manifestShape, await this.#handle.Manifest({ signal: call.signal, callbacks: this.#calls })) as unknown as Manifest);
  }
  size(call: CallOptions = {}): Promise<number> {
    return guard(async () => Number(await this.#handle.Size({ signal: call.signal, callbacks: this.#calls })));
  }
  close(): Promise<void> { return guard(() => this.#handle.close()); }
  [Symbol.asyncDispose](): Promise<void> { return this.close(); }
}

/** The reference's Reader over a loaded TDF; stream methods arrive in Phase 7. */
export class Reader {
  readonly #handle: generated.Reader;
  readonly #calls: Callbacks | undefined;
  /** @internal */
  constructor(handle: generated.Reader, calls: Callbacks | undefined) {
    this.#handle = handle;
    this.#calls = calls;
