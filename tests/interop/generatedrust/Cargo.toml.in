[package]
name = "tdf3-native-consumer"
version = "0.1.0"
edition = "2021"
[dependencies]
opentdf-tdf3 = { path = "@PACKAGE@" }
serde_json = "=1.0.151"
openssl = { version = "=0.10.81", features = ["vendored"] }
base64 = "=0.22.1"
reqwest = { version = "=0.13.5", default-features = false, features = ["rustls", "gzip"] }
tokio = { version = "=1.53.1", features = ["rt", "time", "sync", "macros"] }
